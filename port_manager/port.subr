# Variables needed for the functions below
: "${PREFIX_PORT:?variable unset}"
: "${PREFIX_PORT_BUILD:?variable unset}"
: "${PORTS_MIRROR_BASEURL:?variable unset}"

: "${PORTS_DOWNLOAD_RETRIES:=5}"
: "${PORTS_DOWNLOAD_TIMEOUT:=5}"
: "${PORTS_ALWAYS_USE_MIRROR:=0}"

set -e

# b_port_download(baseurl, filename, [orig_filename])
#  Fetch a file from ${baseurl}${filename} (or ${baseurl}${orig_filename} if provided) and save as ${filename}
#  in current port's directory. Provide ${orig_filename} if filename on the external server doesn't follow the
#  package-X.Y.Z.ext convention (e.g. it's a hash). If download fails, try again from ${PORTS_MIRROR_BASEURL}${filename}.
b_port_download() {
	local baseurl="${1:?baseurl missing}"
	local filename="${2:?filename missing}"
	local orig_filename="${3:-$filename}"

	run_wget() {
		local url="${1?}"
		wget --tries="${PORTS_DOWNLOAD_RETRIES}" \
			--timeout="${PORTS_DOWNLOAD_TIMEOUT}" \
			--progress="dot:mega" \
			"${url}" -O "${PREFIX_PORT}/${filename}.part" --no-check-certificate
	}

	if [ ! -f "${PREFIX_PORT}/${filename}" ]; then
		if [ "${PORTS_ALWAYS_USE_MIRROR}" = "1" ] || ! run_wget "${baseurl}${orig_filename}"; then
			run_wget "${PORTS_MIRROR_BASEURL}${filename}"
		fi

		mv -f "${PREFIX_PORT}/${filename}.part" "${PREFIX_PORT}/${filename}"
	fi
}

# b_port_apply_patches(srcdir, [patch_subdir])
#  Apply patches to files in ${srcdir}. Non-recursive - use multiple calls with
#  ${patch_subdir} if you group patches into separate directories.
b_port_apply_patches() {
	local srcdir="${1:?srcdir missing}"
	local patch_subdir="${2:-.}"

	local patch_dir="${PREFIX_PORT_PATCHES}/${patch_subdir}"
	local marker_dir="${PREFIX_BUILD_MARKERS}/${patch_subdir}"
	if [ -d "${patch_dir}" ]; then
		mkdir -p "${marker_dir}"
	fi

	# Restores the initial value of nullglob option upon function return
	# shellcheck disable=2064
	trap "$(shopt -p nullglob)" RETURN
	shopt -s nullglob

	# The marker records the patch's CONTENT hash, not just its name.
	#
	# Keyed on the filename alone, a patch that is regenerated in place -- same
	# name, different hunks -- is silently skipped, and the port keeps building
	# the OLD patch's source with no diagnostic at all. That is not theoretical
	# here: the game ports' patches are generated from their forks
	# (scripts/game-port-patch.sh in the coordination repo), so their content
	# changes while their names never do.
	#
	# Re-applying the new patch on top of the old one's hunks would conflict or,
	# worse, half-apply, so a changed patch is a hard error naming the fix: the
	# work directory has to be re-extracted.
	for patchfile in "${patch_dir}"/*.patch; do
		local marker="${marker_dir}/$(basename "${patchfile}").applied"
		local want have
		want="$(sha256sum "${patchfile}" | cut -d' ' -f1)"

		if [ -f "${marker}" ]; then
			have="$(cat "${marker}" 2>/dev/null)"
			if [ "${have}" = "${want}" ]; then
				continue
			fi
			b_die "patch changed since it was applied: $(basename "${patchfile}")
  applied: ${have:-<unrecorded, pre-hash marker>}
  current: ${want}
  The work directory still holds the OLD patch's hunks, so this build would
  ship source that matches neither. Remove ${PREFIX_PORT_BUILD:-the port work
  directory} (or run a full clean build) so the port is re-extracted."
		fi

		echo "applying patch: ${patchfile}"
		patch -d "${srcdir}" -p1 <"${patchfile}"
		printf '%s\n' "${want}" >"${marker}"
	done
}

b_install_host() {
	local filelist=("${@:1}")
	local absdir="${PREFIX_BUILD}/host-prog/"
	mkdir -p "$absdir"

	for file in "${filelist[@]}"; do
		if ! [ -f "$file" ]; then
			echo -e "\033[0;31mFile $file does not exist \033[0m"
			exit 1
		fi

		echo -e "\033[0;35mInstalling $(basename "$file") into host-prog\033[0m"
		install -m 755 "$file" "$absdir"
	done
}

# shellcheck disable=2317 # as above
# b_dependency_dir(dep_name)
#  Returns installation directory of a required dependency named ${dep_name}.
#  This directory is a root to `lib` and `include` directories containing
#  dependency libraries and headers. If a required dependency is not
#  installed, returns empty string (but if this happens, your port.def.sh is
#  wrong!).
b_dependency_dir() {
	local res dependency_name dependency_name_env_name
	dependency_name="${1?}"
	dependency_name_env_name="PORT_DEP_${dependency_name}"
	res="${!dependency_name_env_name}"
	if [[ -z "$res" ]]; then
		b_die "dependency for ${dependency_name} required but not installed!"
	fi
	echo "${res}"
}

# b_use(flag_name)
#  Returns 0 if flag is enabled and non-zero value otherwise.
b_use() {
	local use_flag_env_name="PORT_USE_${1?use_flag}"
	[ "${!use_flag_env_name}" = y ]
}

b_use_ensure() {
	local use_flag="${1?use_flag}"
	local reason="${2?reason}"

	if ! b_use "${use_flag}"; then
		b_die "'${use_flag}' not enabled but needed for: ${reason}"
	fi
}

# TODO: add more USE flag helpers


# b_port_invalidate_stale_configure(workdir)
#
# Autoconf freezes its libc feature detection into config.status/config.h, and
# ports re-run ./configure only when config.status is missing. So a port first
# configured before libphoenix implemented some function keeps compiling its
# own fallback forever -- and once the libc HEADER declares that function, the
# port's `static` fallback is no longer merely redundant but a hard error:
#
#   evdns.c: error: static declaration of 'strtok_r' follows
#                   non-static declaration
#
# That broke the whole ports stage after libphoenix gained strtok_r, with
# libevent still carrying a config.log from five days earlier. Sixteen ports
# share the same guard, so this recurs every time we implement a libc function.
#
# Fix: fingerprint the libc API -- the sorted list of symbols libphoenix
# defines -- and drop config.status when it changes, which makes the port's own
# guard re-configure. Keyed on SYMBOLS rather than the archive's mtime or hash,
# so an ordinary rebuild that changes no API does not force all sixteen ports
# to re-run configure. If the key cannot be computed the cached configuration
# is kept: a missing nm must not silently reconfigure everything.
b_port_invalidate_stale_configure() {
	local workdir="$1"
	local stamp="${workdir}/.phoenix-libc-api"
	local sysroot lib nm key

	# Act only on an AUTOCONF tree, identified by config.status or config.log.
	# Makefile must NOT be part of this test: for a non-autoconf port (busybox and
	# friends) the Makefile IS the shipped source, so treating it as configure
	# output would destroy the work directory.
	if [ ! -f "${workdir}/config.status" ] && [ ! -f "${workdir}/config.log" ]; then
		return 0
	fi

	sysroot="$(printf '%s %s' "${CFLAGS:-}" "${LDFLAGS:-}" | tr ' ' '\n' | sed -n 's|^--sysroot=||p' | head -n 1)"
	lib="${sysroot%/}/lib/libphoenix.a"
	if [ -z "$sysroot" ] || [ ! -f "$lib" ]; then
		return 0
	fi

	nm=""
	for candidate in "${HOST:-}-nm" "${CROSS_COMPILE:-}nm"; do
		if [ "$candidate" != "-nm" ] && command -v "$candidate" >/dev/null 2>&1; then
			nm="$candidate"
			break
		fi
	done
	if [ -z "$nm" ]; then
		return 0
	fi

	key="$("$nm" --defined-only --extern-only "$lib" 2>/dev/null | awk '{ print $NF }' | sort -u | sha256sum | cut -d' ' -f1)"
	if [ -z "$key" ]; then
		return 0
	fi

	if [ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$key" ]; then
		return 0
	fi

	# Delete the autoconf OUTPUTS. Recipes guard their configure step on
	# different markers -- config.status for most, config.h for bash -- so
	# removing only one leaves a port believing it is configured while make then
	# tries to regenerate the file we deleted:
	#
	#   /bin/sh: 0: cannot open ./config.status: No such file
	#   make: *** [Makefile:787: config.status] Error 2
	#
	# config.cache goes because it caches the previous run's answers ABOUT THE
	# LIBC, which is precisely what changed (recipes seeding a committed cross
	# cache re-copy it before configure, so nothing is lost).
	echo "port: libc API changed since this port was configured -- re-running configure"
	rm -f "${workdir}/config.status" "${workdir}/config.cache" \
		"${workdir}/config.h" "${workdir}/config.log"

	# Makefile is a configure marker too, for coreutils, python and openssl111,
	# which guard their configure step on `[ ! -f .../Makefile ]`. Leaving it
	# behind is worse than deleting either file alone: the recipe believes it is
	# configured and skips configure, then the stale Makefile tries to regenerate
	# the config.status we just deleted --
	#
	#   /bin/bash: ./config.status: No such file or directory
	#   make: *** [Makefile:8896: config.status] Error 127
	#
	# which is exactly what happened to coreutils-9.5 on 2026-09-03.
	#
	# Only when a Makefile.in sits next to it: that proves configure generated the
	# Makefile. For a port that ships its Makefile as source (busybox and friends)
	# there is no Makefile.in, and deleting it would destroy the work directory --
	# though such a port has no config.status/config.log either, so the gate above
	# has already returned. Requiring Makefile.in makes that safety explicit rather
	# than a consequence of an earlier check.
	if [ -f "${workdir}/Makefile.in" ]; then
		rm -f "${workdir}/Makefile"
	fi
	printf '%s\n' "$key" >"$stamp"
}

export -f b_port_download b_port_apply_patches b_install_host \
	b_port_invalidate_stale_configure \
	b_dependency_dir b_use b_use_ensure
